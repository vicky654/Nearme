NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/nearme
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_PURPOSE_SECRET=replace-with-yet-another-long-random-string
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM="NearMe <no-reply@yourdomain.com>"
CLIENT_URL=http://localhost:5173
# Optional in production: public API origin used in uploaded media URLs.
# PUBLIC_SERVER_URL=https://api.yourdomain.com
# Optional: mount this path on persistent storage for chat media.
# CHAT_UPLOAD_DIR=/var/lib/nearme/chat-uploads
# Optional: enables terminated-app push through FCM HTTP v1 using ADC.
# FCM_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# GOOGLE_CLIENT_ID=set-this-to-enable-google-login
